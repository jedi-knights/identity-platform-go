# Stripe test-mode secrets — template. Copy to a *local* secrets.env (gitignored),
# fill in with values from Stripe Dashboard → Developers → API keys, then load via:
#
#   set -a; source infra/stripe/secrets.env; set +a
#   ./infra/stripe/wire-lago-connector.sh
#
# All values below are TEST-MODE ONLY (prefixed `sk_test_`, `pk_test_`, `whsec_`).
# Never commit filled-in copies. .gitignore excludes infra/stripe/secrets.env.
# Never place a live-mode key here — live keys go to a separate `secrets.live.env`
# that is gitignored by a broader glob and gated on a separate deploy playbook.

# Stripe secret key (server-side). From Dashboard → Developers → API keys.
# Test mode: begins with `sk_test_`.
STRIPE_SECRET_KEY=

# Stripe publishable key (client-side; used by Lago's Checkout redirect page).
# Test mode: begins with `pk_test_`.
STRIPE_PUBLISHABLE_KEY=

# Stripe webhook signing secret. Generated per-endpoint in Stripe Dashboard →
# Developers → Webhooks → <endpoint> → Signing secret.
# Test mode: begins with `whsec_`.
# Set this AFTER creating the webhook endpoint pointing at Lago (see README §4).
STRIPE_WEBHOOK_SIGNING_SECRET=

# Lago API key from Lago admin UI → Developers → API keys. Required so the
# wiring script can POST /api/v1/payment_providers/stripe to configure Lago.
LAGO_API_KEY=

# Lago API base URL. In production, this is the Fly private hostname reached
# via `fly proxy` or the api-gateway. For local testing, set to
# https://api.getlago.com if using Lago Cloud instead of self-hosted.
LAGO_API_URL=https://jk-lago-api.internal:3000
