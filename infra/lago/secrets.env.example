# Lago shared secrets — template. Copy to a *local* secrets.env (gitignored),
# fill in with generated values, and load into Fly via:
#
#   set -a; source infra/lago/secrets.env; set +a
#   fly secrets set -a jk-lago-api --stage \
#     SECRET_KEY_BASE="$SECRET_KEY_BASE" \
#     LAGO_RSA_PRIVATE_KEY="$LAGO_RSA_PRIVATE_KEY" \
#     LAGO_ENCRYPTION_KEY_SALT="$LAGO_ENCRYPTION_KEY_SALT" \
#     LAGO_ENCRYPTION_DETERMINISTIC_KEY="$LAGO_ENCRYPTION_DETERMINISTIC_KEY" \
#     LAGO_ENCRYPTION_PRIMARY_KEY="$LAGO_ENCRYPTION_PRIMARY_KEY"
#
# (Repeat for jk-lago-worker with identical values so both apps decrypt what
# either encrypts.)
#
# The bootstrap.sh script generates and sets these automatically. Use this
# template only when you need to reproduce a specific set of secrets on a
# new environment — for example, restoring from a Postgres dump whose rows
# were encrypted with a known LAGO_ENCRYPTION_PRIMARY_KEY.
#
# DO NOT commit a filled-in copy of this file. .gitignore already excludes
# infra/lago/secrets.env.

# Rails session/cookie signing. 64 hex bytes.
# Generate: openssl rand -hex 64
SECRET_KEY_BASE=

# Lago's RSA signing key (webhooks, JWTs). Base64-encoded PEM.
# Generate: openssl genrsa 2048 | base64 | tr -d '\n'
LAGO_RSA_PRIVATE_KEY=

# ActiveRecord::Encryption key salt. 32 hex bytes.
# Generate: openssl rand -hex 32
LAGO_ENCRYPTION_KEY_SALT=

# ActiveRecord::Encryption deterministic key. 32 hex bytes.
# Generate: openssl rand -hex 32
LAGO_ENCRYPTION_DETERMINISTIC_KEY=

# ActiveRecord::Encryption primary key. 32 hex bytes.
# WARNING: rotating this invalidates existing encrypted rows.
# Generate: openssl rand -hex 32
LAGO_ENCRYPTION_PRIMARY_KEY=

# ---
# Non-shared secrets (per-environment, do not commit values):

# One-shot: used by the initial admin bootstrap Rails runner, then unset.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
